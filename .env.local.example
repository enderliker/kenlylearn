# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Supabase Public API (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Secret (STRICTLY SERVER-SIDE - NEVER PREFIX WITH NEXT_PUBLIC_)
# Bypasses RLS. Use ONLY in internal server actions / background jobs.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Supabase PostgreSQL Database URL (Connection Pooler port 6543 for serverless)
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# ==============================================================================
# Security & NextAuth Keys
# ==============================================================================
# Master encryption key for AES-256-GCM user API key storage (32 hex characters)
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef

# NextAuth Secret
AUTH_SECRET=generate-a-strong-secret-key-via-openssl-rand-hex-32
AUTH_URL=http://localhost:3000

# OAuth Providers (Optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ==============================================================================
# NVIDIA NIM Inference API
# ==============================================================================
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
